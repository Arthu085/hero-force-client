# API origin without a path, credentials, query, or fragment; trailing slashes are normalized away.
# HTTPS required except HTTP on localhost, 127.0.0.1, or [::1]. Public: embedded in the browser bundle.
VITE_API_URL=http://localhost:3000

# Application name for the browser tab, accessible branding, and PWA; short name for the PWA.
VITE_APP_NAME=Hero Force
VITE_APP_MARK=HF
